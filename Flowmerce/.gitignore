# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets and local configuration (never commit real credentials)
.env
.env.*
!.env.example
/secrets/

# Runtime data and logs
/data/
/backups/
frontend/node_modules/
frontend/.next/
frontend/.next-preview/
frontend/out/
logs/*
!logs/.gitkeep
*.log

# Staging area for external projects awaiting integration (may hold real data and secrets)
incoming/

# Brand guides Claude reads (internal: sales figures, briefs). The repository is public: they stay on the
# operator's computer only. The folder's README.md (file list) is committed.
src/flowmerce/modules/seo/knowledge/*/
